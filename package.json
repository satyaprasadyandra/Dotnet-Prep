{
  "name": "dotnet-interview-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "182-day .NET product company interview preparation tracker",
  "scripts": {
    "import-excel": "python scripts/import-excel.py",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/index.js",
    "launch": "npm run build && node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
